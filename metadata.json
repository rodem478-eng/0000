import React, { useState } from 'react';
import { BookOpen, Search, Sparkles, HelpCircle, ChevronDown, ChevronUp, AlertCircle, CheckCircle2 } from 'lucide-react';
import { CATEGORY_MAP, INITIAL_QNA } from '../data/constants';
import { QnAItem, WasteCategory } from '../types';

export const GuideAndQnaTab: React.FC = () => {
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategoryFilter, setSelectedCategoryFilter] = useState<WasteCategory | 'ALL'>('ALL');
  const [expandedId, setExpandedId] = useState<string | null>(INITIAL_QNA[0].id);

  // Custom AI Q&A States
  const [customQuestion, setCustomQuestion] = useState('');
  const [aiAnswer, setAiAnswer] = useState<string | null>(null);
  const [isAsking, setIsAsking] = useState(false);

  // Filter dictionary items
  const filteredQna = INITIAL_QNA.filter((item) => {
    const matchesCategory = selectedCategoryFilter === 'ALL' || item.category === selectedCategoryFilter;
    const matchesSearch =
      item.question.includes(searchQuery) ||
      item.answer.includes(searchQuery) ||
      item.tags.some((tag) => tag.includes(searchQuery));
    return matchesCategory && matchesSearch;
  });

  // Handle Custom AI Question Submit
  const handleAskAi = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!customQuestion.trim()) return;

    setIsAsking(true);
    setAiAnswer(null);

    try {
      const response = await fetch('/api/gemini/ask-qna', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: customQuestion }),
      });

      const data = await response.json();
      if (data.success && data.answer) {
        setAiAnswer(data.answer);
      } else {
        setAiAnswer('답변을 가져오는 중 오류가 발생했습니다.');
      }
    } catch (err) {
      console.error('Q&A error:', err);
      setAiAnswer('네트워크 오류가 발생했습니다.');
    } finally {
      setIsAsking(false);
    }
  };

  return (
    <div className="space-y-6 pb-24">
      {/* Tab Banner */}
      <div className="bg-gradient-to-r from-teal-900 to-emerald-900 text-white rounded-3xl p-5 shadow-lg">
        <div className="inline-flex items-center gap-1.5 bg-teal-400/20 text-teal-200 text-xs px-2.5 py-0.5 rounded-full font-medium mb-1 border border-teal-400/30">
          <BookOpen className="w-3.5 h-3.5 text-amber-300" />
          분리배출 대백과 & AI 챗봇
        </div>
        <h2 className="text-xl font-bold">분리수거 백과사전 & 맞춤 Q&A</h2>
        <p className="text-xs text-teal-100/90 mt-1">
          환경부 표준 분류법부터 애매했던 특수 쓰레기 처리법까지 한번에 찾아보세요.
        </p>
      </div>

      {/* AI Instant Question Box */}
      <div className="bg-white rounded-3xl p-5 border border-slate-200 shadow-xs space-y-3">
        <h3 className="font-bold text-xs text-slate-800 flex items-center gap-1.5">
          <Sparkles className="w-4 h-4 text-emerald-600" />
          궁금한 쓰레기 분리배출법 바로 물어보기
        </h3>

        <form onSubmit={handleAskAi} className="flex gap-2">
          <input
            type="text"
            value={customQuestion}
            onChange={(e) => setCustomQuestion(e.target.value)}
            placeholder="예: 다 쓴 약통, 화장품 용기, 캣타워는 어떻게 버려요?"
            className="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-800 focus:outline-hidden focus:border-teal-500"
          />
          <button
            type="submit"
            disabled={isAsking || !customQuestion.trim()}
            className="bg-teal-600 hover:bg-teal-700 disabled:opacity-50 text-white font-bold text-xs px-4 py-2 rounded-xl flex items-center gap-1 shadow-xs"
          >
            {isAsking ? '답변중...' : 'AI 질문'}
          </button>
        </form>

        {aiAnswer && (
          <div className="p-4 bg-teal-50 border border-teal-200 rounded-2xl text-xs text-slate-800 leading-relaxed space-y-2 animate-in fade-in duration-200">
            <span className="font-bold text-teal-800 flex items-center gap-1">
              <CheckCircle2 className="w-4 h-4 text-teal-600" />
              eco AI의 답변
            </span>
            <div className="whitespace-pre-line text-slate-700">{aiAnswer}</div>
          </div>
        )}
      </div>

      {/* Dictionary Search & Categories Filter */}
      <div className="space-y-3">
        <div className="relative">
          <Search className="w-4 h-4 text-slate-400 absolute left-3.5 top-3" />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="품목명 검색 (피자상자, 우유팩, 깨진유리, 건전지 등)"
            className="w-full bg-white border border-slate-200 rounded-2xl pl-10 pr-4 py-2.5 text-xs text-slate-800 focus:outline-hidden focus:border-teal-500 shadow-xs"
          />
        </div>

        {/* Category Filter Pills */}
        <div className="flex gap-1.5 overflow-x-auto pb-1 scrollbar-none">
          <button
            onClick={() => setSelectedCategoryFilter('ALL')}
            className={`px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all ${
              selectedCategoryFilter === 'ALL'
                ? 'bg-slate-900 text-white shadow-xs'
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
            }`}
          >
            전체 보기
          </button>
          {Object.keys(CATEGORY_MAP).map((catKey) => {
            const cat = CATEGORY_MAP[catKey as WasteCategory];
            const isSelected = selectedCategoryFilter === catKey;

            return (
              <button
                key={catKey}
                onClick={() => setSelectedCategoryFilter(catKey as WasteCategory)}
                className={`px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all ${
                  isSelected ? 'bg-teal-700 text-white shadow-xs' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              >
                {cat.name}
              </button>
            );
          })}
        </div>
      </div>

      {/* Q&A Accordion List */}
      <div className="space-y-2.5">
        {filteredQna.length === 0 ? (
          <div className="bg-white rounded-3xl p-8 text-center text-xs text-slate-400 border border-slate-200">
            검색 결과가 없습니다. 상단 AI 질문창에 바로 적어서 물어보세요!
          </div>
        ) : (
          filteredQna.map((item) => {
            const isExpanded = expandedId === item.id;
            const cat = CATEGORY_MAP[item.category];

            return (
              <div
                key={item.id}
                className="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden transition-all"
              >
                <button
                  onClick={() => setExpandedId(isExpanded ? null : item.id)}
                  className="w-full p-4 text-left flex items-start justify-between gap-3 hover:bg-slate-50"
                >
                  <div className="space-y-1">
                    <span className={`inline-block text-[10px] font-bold px-2 py-0.5 rounded-md ${cat.badgeBg} ${cat.badgeText}`}>
                      {cat.name}
                    </span>
                    <h4 className="font-bold text-xs text-slate-900 leading-snug">{item.question}</h4>
                  </div>
                  {isExpanded ? <ChevronUp className="w-4 h-4 text-slate-400 shrink-0" /> : <ChevronDown className="w-4 h-4 text-slate-400 shrink-0" />}
                </button>

                {isExpanded && (
                  <div className="px-4 pb-4 border-t border-slate-100 bg-slate-50/50 pt-3 space-y-2 text-xs">
                    <div className="p-2.5 bg-emerald-100/70 border border-emerald-200 rounded-xl font-bold text-emerald-900 flex items-center gap-1.5">
                      <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0" />
                      <span>{item.keyRule}</span>
                    </div>
                    <p className="text-slate-700 leading-relaxed">{item.answer}</p>
                    <div className="flex flex-wrap gap-1 pt-1">
                      {item.tags.map((tag, idx) => (
                        <span key={idx} className="text-[10px] text-slate-500 bg-slate-200 px-2 py-0.5 rounded-full">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            );
          })
        )}
      </div>
    </div>
  );
};
